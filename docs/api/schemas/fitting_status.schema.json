{
  "$defs": {
    "ErrorCode": {
      "description": "오류 코드 (명세서 12장).",
      "enum": [
        "INPUT_INVALID",
        "GARMENT_NOT_READY",
        "BODY_FIT_NOT_CONVERGED",
        "DRAPE_INVALID",
        "RENDER_FAILED",
        "REALIZE_TIMEOUT",
        "EXTERNAL_SUBMIT_UNKNOWN",
        "VALIDATION_FAILED",
        "VALIDATION_UNVERIFIABLE",
        "BUDGET_LIMIT"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "FitLabel": {
      "description": "부위별 판정. 가슴·허리는 네 단계, 어깨는 세 단계 (명세서 4장).\n\nREGULAR, UNKNOWN은 명세서 예시에 나온 이름이고 나머지 이름은 [제안]이다.",
      "enum": [
        "INSUFFICIENT",
        "SNUG",
        "REGULAR",
        "LOOSE",
        "NARROW",
        "DROPPED",
        "UNKNOWN",
        "NOT_EVALUATED"
      ],
      "title": "FitLabel",
      "type": "string"
    },
    "JobStatus": {
      "description": "작업 전체 상태 (명세서 11장).",
      "enum": [
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "PARTIAL_SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "QualityStatus": {
      "description": "실사 영상 자동 검증 결과. PENDING은 명세서 예시, 나머지는 7장의 PASS/FAIL/UNVERIFIABLE.",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "UNVERIFIABLE"
      ],
      "title": "QualityStatus",
      "type": "string"
    },
    "ReasonCode": {
      "description": "판정하지 않은 이유. MEASUREMENT_NOT_COMPARABLE만 명세서에 이름이 있다.",
      "enum": [
        "MEASUREMENT_NOT_COMPARABLE",
        "MEASUREMENT_MISSING",
        "NO_DIRECT_BODY_COUNTERPART",
        "BODY_INPUT_NOT_PROVIDED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Region": {
      "description": "핏 리포트의 부위. 리포트에는 아래 순서로 모두 포함한다 (명세서 11장).",
      "enum": [
        "chest",
        "shoulder",
        "waist",
        "sleeve",
        "body_length"
      ],
      "title": "Region",
      "type": "string"
    },
    "RegionResult": {
      "additionalProperties": false,
      "description": "한 부위의 비교 결과.\n\n비교하지 않은 부위는 ease_cm을 null로 두고 reason_code에 이유를 넣는다.\nbody_cm, garment_cm은 입력 원래 값이고, ease_cm은 반올림하지 않은 차이다.\n화면에 보일 때만 소수점 한 자리로 반올림한다.",
      "properties": {
        "body_cm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Body Cm"
        },
        "ease_cm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ease Cm"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "garment_cm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Garment Cm"
        },
        "label": {
          "$ref": "#/$defs/FitLabel"
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "$ref": "#/$defs/Region"
        }
      },
      "required": [
        "region",
        "body_cm",
        "garment_cm",
        "ease_cm",
        "label",
        "explanation"
      ],
      "title": "RegionResult",
      "type": "object"
    },
    "ReportPart": {
      "additionalProperties": false,
      "description": "핏 경로 상태. 완료하면 리포트의 부위별 결과를 함께 돌려준다.",
      "properties": {
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regions": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RegionResult"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regions"
        },
        "rules_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules Version"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "ReportPart",
      "type": "object"
    },
    "Stage": {
      "description": "작업 단계. 핏 경로 2개, 영상 경로 5개.\n\n명세서 11장의 수동 검수(REVIEW)·게시(PUBLISH) 단계는 활동지 범위에 없어 뺐다\n(docs/decisions.md 2026-11-10). 실사 영상의 품질은 VALIDATE(#11)의 자동 검증으로만 판정한다.",
      "enum": [
        "FIT_CALCULATE",
        "FIT_REPORT",
        "BODY_FIT",
        "DRAPE",
        "RENDER",
        "REALIZE",
        "VALIDATE"
      ],
      "title": "Stage",
      "type": "string"
    },
    "StageProgress": {
      "additionalProperties": false,
      "description": "[제안] 단계별 진행. 화면이 단계명과 대기 여부를 표시하는 데 쓴다.",
      "properties": {
        "attempt_no": {
          "minimum": 1,
          "title": "Attempt No",
          "type": "integer"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        }
      },
      "required": [
        "stage",
        "status",
        "attempt_no"
      ],
      "title": "StageProgress",
      "type": "object"
    },
    "StageStatus": {
      "description": "단계와 경로의 상태 (명세서 11장).",
      "enum": [
        "WAITING",
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "SKIPPED",
        "CANCELLED"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "VisualPart": {
      "additionalProperties": false,
      "description": "영상 경로 상태. report_only 작업은 status가 SKIPPED다.\n\n3D 미리보기(`drape_preview_artifact_id`)는 실사화가 실패해도 남아 있으면 보여 준다(#12).\n검증에서 기준을 넘으면 `quality_status`가 FAIL이고 `error_code`가 VALIDATION_FAILED다(#11).",
      "properties": {
        "drape_preview_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drape Preview Artifact Id"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Artifact Id"
        },
        "quality_status": {
          "$ref": "#/$defs/QualityStatus",
          "default": "PENDING"
        },
        "render_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Render Artifact Id"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/StageStatus"
        },
        "video_artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Artifact Id"
        }
      },
      "required": [
        "status"
      ],
      "title": "VisualPart",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "작업 전체 상태와 두 경로의 상태.",
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/ReportPart"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageProgress"
      },
      "title": "Stages",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "visual": {
      "$ref": "#/$defs/VisualPart"
    }
  },
  "required": [
    "job_id",
    "status",
    "report",
    "visual"
  ],
  "title": "FittingStatus",
  "type": "object"
}
