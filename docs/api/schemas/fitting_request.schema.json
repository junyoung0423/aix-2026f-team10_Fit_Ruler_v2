{
  "$defs": {
    "Measurements": {
      "additionalProperties": false,
      "description": "사용자가 입력하는 다섯 신체 치수. 단위는 cm이다.",
      "properties": {
        "arm_length_cm": {
          "maximum": 85.0,
          "minimum": 40.0,
          "title": "Arm Length Cm",
          "type": "number"
        },
        "chest_cm": {
          "maximum": 160.0,
          "minimum": 60.0,
          "title": "Chest Cm",
          "type": "number"
        },
        "height_cm": {
          "maximum": 210.0,
          "minimum": 140.0,
          "title": "Height Cm",
          "type": "number"
        },
        "shoulder_cm": {
          "maximum": 60.0,
          "minimum": 28.0,
          "title": "Shoulder Cm",
          "type": "number"
        },
        "waist_cm": {
          "maximum": 160.0,
          "minimum": 50.0,
          "title": "Waist Cm",
          "type": "number"
        }
      },
      "required": [
        "height_cm",
        "chest_cm",
        "waist_cm",
        "shoulder_cm",
        "arm_length_cm"
      ],
      "title": "Measurements",
      "type": "object"
    },
    "Mode": {
      "description": "실행 방식 (명세서 3장).",
      "enum": [
        "report_only",
        "full"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "POST /api/fittings 요청 본문 (명세서 11장). Idempotency-Key는 헤더로 받는다.",
  "properties": {
    "garment_variant_id": {
      "minLength": 1,
      "title": "Garment Variant Id",
      "type": "string"
    },
    "measurement_protocol_version": {
      "enum": [
        "measure_v1"
      ],
      "title": "Measurement Protocol Version",
      "type": "string"
    },
    "measurements": {
      "$ref": "#/$defs/Measurements"
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "full"
    },
    "realize_consent": {
      "default": false,
      "title": "Realize Consent",
      "type": "boolean"
    }
  },
  "required": [
    "garment_variant_id",
    "measurements",
    "measurement_protocol_version"
  ],
  "title": "FittingRequest",
  "type": "object"
}
