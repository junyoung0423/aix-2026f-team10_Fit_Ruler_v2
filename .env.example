# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
FAL_KEY=
BLENDER_PATH=
SMPL_MODEL_DIR=

# 어댑터 설정: config/adapters/ 안의 이름(default, fake)이나 yaml 파일 경로. 비우면 default.
FIT_ADAPTERS=
# 어댑터의 중간 파일(.blend, 메시 등) 폴더. 비우면 artifacts/work/.
FIT_WORK_DIR=

# 착장 어댑터(C4, config/adapters/drape_blender.yaml). docs/adapters.md "착장 어댑터" 절.
# GarmentCode용 Python 3.9. 비우면 C:\dev\venvs\garmentcode\Scripts\python.exe
FIT_GC_PYTHON=
# 의류 준비 기록 폴더(tools/prepare_garments.py). 비우면 data/prepared/
FIT_PREPARED_DIR=
# 개발·시연용 몸 OBJ(D3 전). 예: C:\dev\GarmentCode\assets\bodies\mean_all.obj. 비우면 입력 몸 메시를 쓴다
FIT_DRAPE_BODY_OBJ=
