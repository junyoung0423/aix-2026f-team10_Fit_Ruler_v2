# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.
#
# 서버(uvicorn server.app:app)와 python -m tools.run_fitting_once · tools.check_env ·
# tools.prepare_garments가 시작할 때 읽어, 비어 있는 환경변수만 채운다(이미 있는 환경변수가 우선).
# 빈 값은 넣지 않으므로 필요한 줄만 채우면 된다. 경로에 공백이 있어도 따옴표 없이 적어도 된다.
# 채운 뒤 확인: python -m tools.check_env --adapters <쓸 설정>   (README "설치")

# --- 외부 도구 -------------------------------------------------------------------------------------
# fal API 키(실사화 D4). 값은 출력·커밋하지 않는다. 실제 호출은 비용이 든다
FAL_KEY=
# Blender 5.2 실행 파일(착장 C4·렌더 C5). 예: C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
BLENDER_PATH=
# SMPL 중성 모델 폴더(몸 D3). 예: models/smpl. 각자 받는다(docs/spikes/smpl-body-measure.md 4절)
SMPL_MODEL_DIR=

# --- 어댑터·서버 공통 ------------------------------------------------------------------------------
# 어댑터 설정: config/adapters/ 안의 이름(default, fake, drape_render_blender, visual_real 등)이나
# yaml 파일 경로. 비우면 default.
FIT_ADAPTERS=
# 어댑터의 중간 파일(.blend, 메시 등) 폴더. 비우면 artifacts/work/
FIT_WORK_DIR=
# 서버 산출물 폴더. 비우면 artifacts/files/ (run_fitting_once는 결과 폴더 안 artifacts/)
FIT_ARTIFACTS_DIR=
# 등록 의류 폴더. 비우면 data/garments/. AI Hub 의류는 저장소 밖(예: C:\dev\aihub\garments)
FIT_GARMENTS_DIR=
# 실패 처리 설정(단계별 시간 제한 등). 비우면 config/pipeline_v0.yaml
FIT_PIPELINE_CONFIG=
# 서버에서 동시에 도는 영상 경로 수. 비우면 1
FIT_MAX_WORKERS=

# --- 의류 준비·착장 (C4, docs/adapters.md "착장 어댑터") -----------------------------------------
# GarmentCode용 Python 3.9. 비우면 C:\dev\venvs\garmentcode\Scripts\python.exe
FIT_GC_PYTHON=
# GarmentCode 루트. 비우면 C:\dev\GarmentCode
FIT_RULER_GC_ROOT=
# 의류 준비 기록 폴더(tools/prepare_garments.py). 비우면 data/prepared/
FIT_PREPARED_DIR=
# 개발·시연용 몸 OBJ. 몸 단계가 가짜일 때 착장에 꼭 필요하다(사용자 몸이 아님).
# 예: C:\dev\GarmentCode\assets\bodies\mean_all.obj. 몸이 실제(SMPL)면 비운다
FIT_DRAPE_BODY_OBJ=
# 원단 → 천 물성 매핑 표. 비우면 config/drape/fabric_map_v0.yaml, off면 끈다
FIT_DRAPE_FABRIC_MAP=

# --- 가짜 모드(화면 연습용, 영상 포트 5개가 모두 가짜일 때만) -----------------------------------
# 가짜 영상 단계마다 쉬는 초. 비우면 0
FIT_FAKE_STAGE_DELAY_S=
# 1이면 이미지 산출물에 단색 자리표시 PNG를 쓴다
FIT_FAKE_PLACEHOLDERS=
